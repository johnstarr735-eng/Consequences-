+  const relationLegibility=clamp((avg(rels.map(r=>clamp(Math.min(.26,(r.witness||0)/20)+Math.min(.20,(r.encounters||0)/20)+(r.conductance||0)*.34+(r.autonomy||0)*.20)))||0));
