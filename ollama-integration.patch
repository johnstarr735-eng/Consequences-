+// Public, serializable setting contracts. Story incidents and participants are
+// fictional. New supernatural mechanisms require a supported engine process.
+export const ENVIRONMENTS=[
+  {id:'port-serein',family:'present',title:'Port Serein',place:'Harbour observatory',period:'Present day · 2026',date:'2026-10-17',description:'An open court, a death during the watch, and three accounts that disagree.',history:'A municipal observatory whose signal room and stores now share space with a civic inquiry.',authority:'One local officer checks received reports. The inquiry admits both players to the open records.',technology:'Mobile calls, SMS and internet; WiFi depends on its router, power and uplink.',communication:'Speech, carried writing and working handsets.',electronic:true,victim:'Rowan',officer:'Officer Vale',record:'Signal log',titles:['The Night Watch','The Missing Weight','The Last Signal'],sources:[]},
+  {id:'roman-court',family:'historical',title:'The Roman Records Court',place:'Rome · a fictional records courtyard',period:'Historical fiction · AD 100',date:'AD 100 · inquiry day',description:'A clerk is dead. A borrowed key, a marked weight and surviving written accounts remain.',history:'A fictional household records court in imperial Rome. The incident and all participants are invented; the local inquiry is a game premise, not a reconstruction of Roman criminal procedure.',authority:'A household steward has admitted both investigators; one hired guard checks reports in person. No modern police organisation is assumed.',technology:'Hand-carried ink writing on wooden leaves. No phones, electrical recorder, wristwatch or internet.',communication:'Speaking distance, physically carried records and another person willing to relay words.',electronic:false,victim:'Lucan',officer:'Marcus the guard',record:'Watch tally',titles:['The Ninth Ledger','Death in the Records Court','The Borrowed Key'],sources:[{title:'British Museum: ink-written wooden leaf tablet',url:'https://www.britishmuseum.org/collection/object/H_1986-1001-64'}]},
+  {id:'lantern-keep',family:'fantasy',title:'Lantern Keep',place:'The Free City · record keep',period:'Fantasy · Year 312 of the Lantern',date:'Lantern 18 · Year 312',description:'The keeper of the night ledger is dead, and the city’s morning hearing is approaching.',history:'An invented trading city governed by a council of ward representatives. A recent store shortage has brought its record keep under scrutiny.',authority:'The council has opened a hearing. One watchkeeper checks reports; factions and titles grant no automatic obedience.',technology:'Ink, paper, metal weights and carried light. This profile has no working magic, telepathy or electrical communication.',communication:'Local voices and physically carried writing. Messages need someone able and willing to carry them.',electronic:false,victim:'Rowan',officer:'Watchkeeper Vale',record:'Watch tally',titles:['The Lantern Ledger','The Last Watchkeeper','A Weight of Silence'],sources:[]},
+];
+export const DIFFICULTIES=[
+  {id:'easy',title:'Easy',deadlineMinutes:240,description:'Four hours. Clear leads and explanations in your notebook.',guided:true},
+  {id:'medium',title:'Medium',deadlineMinutes:180,description:'Three hours. A starting lead each, with competing accounts.',guided:false},
+  {id:'difficult',title:'Difficult',deadlineMinutes:120,description:'Two hours. Less initial direction; the same evidence and physical rules.',guided:false},
+];
+export const environmentById=id=>ENVIRONMENTS.find(e=>e.id===id);
+export const difficultyById=id=>DIFFICULTIES.find(d=>d.id===id);
+function mix(value){let x=value>>>0;x=Math.imul(x^(x>>>16),0x21f0aaad);x=Math.imul(x^(x>>>15),0x735a2d97);return(x^(x>>>15))>>>0;}
+export function defaultRecipe(profileId='port-serein',seed=1){const e=environmentById(profileId);return{version:1,profileId,titleIndex:mix(seed^0x9e3779b9)%e.titles.length,leadOrder:mix(seed^0x243f6a88)%2,culpritIndex:Math.abs(seed)%3,openingIndex:mix(seed^0xb7e15162)%3};}
+export function validateRecipe(input,profileId){
+  if(!input||typeof input!=='object'||Object.keys(input).some(k=>!['version','profileId','titleIndex','leadOrder','culpritIndex','openingIndex'].includes(k))||input.version!==1||input.profileId!==profileId||!environmentById(profileId)||![['titleIndex',3],['leadOrder',2],['culpritIndex',3],['openingIndex',3]].every(([k,n])=>Number.isInteger(input[k])&&input[k]>=0&&input[k]<n))throw new Error('The scenario generator returned an unsupported starting configuration.');
+  return{...input};
+}
+export const SCENARIO_SCHEMA={type:'object',additionalProperties:false,properties:{version:{type:'integer',enum:[1]},profileId:{type:'string',enum:ENVIRONMENTS.map(e=>e.id)},titleIndex:{type:'integer',minimum:0,maximum:2},leadOrder:{type:'integer',minimum:0,maximum:1},culpritIndex:{type:'integer',minimum:0,maximum:2},openingIndex:{type:'integer',minimum:0,maximum:2}},required:['version','profileId','titleIndex','leadOrder','culpritIndex','openingIndex']};
