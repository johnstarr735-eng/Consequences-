+    cold:clamp(.38-.26*Math.sin(phase)+.13*Math.sin(days*.31)),
+    heat:clamp(.28+.30*Math.sin(phase)+.10*Math.sin(days*.19)),
+    wet:clamp(.32+.20*Math.sin(days*.13)+.15*Math.sin(days*.047)),
+    wind:clamp(.25+.22*Math.sin(days*.17+1.2)),
+    light:0
