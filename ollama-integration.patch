+// Public setup choices. These describe supported initial history, not outcomes.
+export const ROLES=[{id:'researcher',title:'Records investigator',basis:'Admitted to examine the court’s open records. No power to compel answers.'},{id:'caregiver',title:'Caregiver',basis:'Has worked caring for people. Admitted to the inquiry; care does not grant access to private knowledge.'},{id:'officer',title:'Guard / officer',basis:'Has served in local security. This inquiry grants no automatic obedience, detention or search result.'},{id:'resident',title:'Local civilian',basis:'Knows this locality from prior visits and has been admitted to the same open inquiry.'}];
+export const BACKGROUNDS=[{id:'records',title:'Records work',history:'Years handling, reading and comparing records in the local script.',observation:'inscribed-surface'},{id:'care',title:'Practical care',history:'Repeated supervised observation of people’s visible bodily condition.',observation:'visible-body'},{id:'grappling',title:'Practised grappling',history:'Regular, recent supervised practice of resisting and maintaining bodily contact.',handling:{counterpartKind:'person',contact:'direct',timeProfile:'sustained',instrument:false}},{id:'former-service',title:'Former service',history:'Past service included carrying equipment and routine duties; no grappling experience is assumed.',},{id:'local',title:'Local working life',history:'Repeated work and prior visits in this locality; ordinary familiarity, no hidden knowledge.',}];
+export const PHYSIQUES=[{id:'balanced',title:'Balanced build',description:'Ordinary adult load, force and mobility.'},{id:'light',title:'Lighter build',description:'Less material mass and force; slightly greater mobility.'},{id:'solid',title:'Heavier build',description:'More material mass and force; slightly lower mobility.'}];
+export const CHARACTER_PRESETS=[{id:'investigator',title:'The investigator',role:'researcher',background:'records',physique:'balanced'},{id:'caregiver',title:'The caregiver',role:'caregiver',background:'care',physique:'balanced'},{id:'officer',title:'The serving officer',role:'officer',background:'local',physique:'solid'},{id:'veteran',title:'The former service member',role:'resident',background:'former-service',physique:'solid'},{id:'wrestler',title:'The civilian wrestler',role:'resident',background:'grappling',physique:'balanced'}];
