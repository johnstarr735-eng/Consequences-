diff --git a/lib/ai-provider.mjs b/lib/ai-provider.mjs
new file mode 100644
index 0000000..5869bfb
--- /dev/null
+++ b/lib/ai-provider.mjs
@@ -0,0 +1,48 @@
+import {GameError} from './simulation.mjs';
+
+/** @typedef {{provider?:string,apiKey?:string,model?:string,baseUrl?:string,fetcher?:typeof fetch,timeoutMs?:number}} AIOptions */
+
+// Provider transport only. Schema/plan compilation, access and actualisation
+// remain in the existing game. Selecting Ollama never falls back to OpenAI.
+/** @param {AIOptions} options */
+export function createStructuredRequester({provider,apiKey,model,baseUrl,fetcher=fetch,timeoutMs=25000}={}){
+  const selected=provider??(apiKey?'openai':'disabled');
+  if(selected==='disabled')return null;
+  if(!['ollama','openai'].includes(selected))throw new GameError('Choose AI_PROVIDER=ollama, openai or disabled.',503);
+  if(selected==='openai'&&!apiKey)return null;
+  if(!Number.isFinite(timeoutMs)||timeoutMs<1||timeoutMs>30000)throw new GameError('The AI request timeout must be between 1 and 30000 milliseconds.',503);
+  let url;
+  if(selected==='ollama'){
+    try{url=new URL('/api/chat',baseUrl||'http://127.0.0.1:11434');}catch{throw new GameError('The local Ollama address is invalid.',503);}
+    if(url.protocol!=='http:'||!['127.0.0.1','localhost','[::1]'].includes(url.hostname)||url.username||url.password)throw new GameError('This Ollama adapter requires a loopback HTTP address on the backend machine.',503);
+    if(typeof model!=='string'||!model.trim()||model.length>160||/[\s\u0000-\u001f]/.test(model))throw new GameError('Set OLLAMA_MODEL to an installed local model name.',503);
+    if(/(?:^|[-:/])cloud(?:$|[-:/])/i.test(model))throw new GameError('Choose a downloaded local model, rather than an Ollama cloud model.',503);
+  }
+  const chosenModel=model||(selected==='openai'?'gpt-5.4-mini':null);
+  return async({instructions,input,schema,name,maxOutputTokens=1800})=>{
+    const local=selected==='ollama';
+    const body=local?{
+      model:chosenModel,stream:false,think:false,format:schema,
+      options:{temperature:0,num_predict:maxOutputTokens},
+      messages:[{role:'system',content:`${instructions}\n\nResponse schema:\n${JSON.stringify(schema)}`},{role:'user',content:JSON.stringify(input)}],
+    }:{model:chosenModel,store:false,instructions,input:JSON.stringify(input),max_output_tokens:maxOutputTokens,text:{format:{type:'json_schema',name,strict:true,schema}}};
+    let response;
+    try{
+      response=await fetcher(local?url:'https://api.openai.com/v1/responses',{
+        method:'POST',redirect:'error',
+        headers:local?{'Content-Type':'application/json'}:{Authorization:`Bearer ${apiKey}`,'Content-Type':'application/json'},
+        signal:AbortSignal.timeout(timeoutMs),body:JSON.stringify(body),
+      });
+    }catch{throw new GameError(local?'Local Ollama could not be reached in time. Check that the backend can reach the installed model. No AI plan was committed.':'The language interpreter could not be reached. No AI plan was committed.',503);}
+    if(!response.ok)throw new GameError(response.status===429?'The language interpreter is busy or its usage limit has been reached. Nothing was committed.':local?'Local Ollama returned an error. Check the installed model and server. No AI plan was committed.':'The language interpreter is unavailable. No AI plan was committed.',503);
+    let data;
+    try{data=await response.json();}catch{throw new GameError('The interpreter returned an unreadable response. No AI plan was committed.',503);}
+    const content=Array.isArray(data?.output)?data.output.flatMap(o=>Array.isArray(o?.content)?o.content:[]):[];
+    if(content.some(c=>c?.type==='refusal'))throw new GameError('The interpreter could not translate this wording. No outcome has been committed.');
+    const output=local?data?.message?.content:content.filter(c=>c?.type==='output_text').map(c=>c.text).join('');
+    let value;
+    try{if(typeof output!=='string')throw new Error();value=JSON.parse(output);}catch{throw new GameError('The interpreter returned an incomplete response. No AI plan was committed.',503);}
+    if(!value||typeof value!=='object'||Array.isArray(value))throw new GameError('The interpreter returned an invalid response object. No AI plan was committed.',503);
+    return value;
+  };
+}
diff --git a/lib/case-agency.mjs b/lib/case-agency.mjs
new file mode 100644
index 0000000..c7af6da
--- /dev/null
+++ b/lib/case-agency.mjs
@@ -0,0 +1,55 @@
+import {NAMES, namesFor,MINUTE,person,visible,reachable,entry} from './case-world.mjs';
+import {conscious,bodyState} from './case-life.mjs';
+import {acquire} from './case-communication.mjs';
+import {observationEfficiency} from './character-model.mjs';
+
+// Attention is supported activity over physical time, not a new reservoir or bonus.
+// The coefficients are app calibration; source reconciliation is in docs/SITUATED_AGENCY.md.
+export function attentionRate(p){
+  if(!conscious(p))return 0;
+  const a=p.apparatus,b=p.body;
+  return Math.max(0,Math.min(1,a.attention))*Math.max(0,Math.min(1,a.receptor))*Math.sqrt(Math.max(0,b.energy*b.water))*Math.max(0,b.integrity);
+}
+export function advanceAttention(s,seat,t,dtDays){
+  if(!t||!['inspect','focus','purpose','self_account'].includes(t.kind))return;
+  t.attentionTracked=true;t.attentionWork??=0;t.attentionElapsed??=0;t.attentionElapsed+=dtDays;
+  const target=t.target,accessible=!target||(t.kind==='inspect'?reachable(s,seat,target):visible(s,seat,target));
+  if(accessible)t.attentionWork+=attentionRate(person(s,seat))*dtDays/MINUTE*(t.kind==='inspect'?observationEfficiency(s,seat,target):1);
+}
+export function hasInspectionAttention(s,seat,t){return (t.attentionTracked?t.attentionWork:attentionRate(person(s,seat))*t.duration/MINUTE)>=1-1e-10;}
+function selfState(s,seat){s.agency||={};return s.agency[seat]||=( {purpose:null,selfAccount:null,reflections:[],presentations:[],attention:[]} );}
+function retainedAnchors(s,seat,words){
+  const p=person(s,seat);return Object.entries(namesFor(s)).filter(([id,name])=>id!==seat&&p.known.has(id)&&new RegExp(`\\b${name.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}\\b`,'i').test(words)).map(([id])=>id);
+}
+export function completeAgencyTask(s,seat,t){
+  if(t.kind==='purpose'||t.kind==='self_account'){
+    const work=t.attentionTracked?t.attentionWork:attentionRate(person(s,seat))*t.duration/MINUTE;
+    if(work<.15){entry(s,[seat],'consequence','You cannot sustain this reflection under your present condition. Your earlier account remains.');return true;}
+    const a=selfState(s,seat),r={id:`reflection:${++s.serial}`,kind:t.kind,text:t.words,at:s.world.elapsedDays,anchors:retainedAnchors(s,seat,t.words)};
+    a.reflections.push(r);a[t.kind==='purpose'?'purpose':'selfAccount']=r;
+    entry(s,[seat],'private',t.kind==='purpose'?`Your present purpose: ${t.words}. Your original game objective remains the same.`:`Your account of yourself: ${t.words}. This is your account; other people retain their own encounters.`);return true;
+  }
+  if(t.kind!=='focus')return false;
+  const work=t.attentionTracked?t.attentionWork:attentionRate(person(s,seat))*t.duration/MINUTE;
+  if(!visible(s,seat,t.target)||work<.2){entry(s,[seat],'consequence',`You cannot sustain a current observation of ${namesFor(s)[t.target]}. A remembered person or place is not current access.`);return true;}
+  const a=selfState(s,seat),f=person(s,t.target),r={target:t.target,at:s.world.elapsedDays,position:{...f.pos},source:'direct_attention',status:f.kind==='person'?bodyState(f):null};
+  a.attention.push(r);
+  if(f.kind==='person'){
+    const text=`While watching, you encounter ${namesFor(s)[t.target]} ${r.status} at this position. This does not establish their thoughts or the beginning of an earlier event.`;
+    acquire(s,seat,{root:`attention:${t.target}:${++s.serial}`,version:1,title:`Watching ${namesFor(s)[t.target]}`,text,category:'observation'},'direct');entry(s,[seat],'observation',text);
+  }else entry(s,[seat],'observation',`You keep ${namesFor(s)[t.target]} in attention. Its presence is encountered; close inspection is still needed to acquire fine marks or writing.`);
+  return true;
+}
+export function introductionRecord(s,seat,words){return {root:`identity-claim:${++s.serial}`,version:1,title:`${namesFor(s)[seat]}’s introduction`,text:words,category:'identity_claim',producer:seat};}
+export function retainPresentation(s,seat,to,record,reached){selfState(s,seat).presentations.push({root:record.root,words:record.text,to,reached,at:s.world.elapsedDays});}
+
+export function agencyView(s,seat){
+  const a=s.agency?.[seat],p=person(s,seat),projection=p.willProjection;
+  return {purpose:a?.purpose?{text:a.purpose.text,anchors:a.purpose.anchors.map(id=>({id,name:namesFor(s)[id]}))}:null,selfAccount:a?.selfAccount?.text||null,
+    reflections:(a?.reflections||[]).map(r=>({kind:r.kind,text:r.text})),
+    presentations:(a?.presentations||[]).map(r=>({words:r.words,to:namesFor(s)[r.to],reached:r.reached})),
+    lastAttention:a?.attention.at(-1)?{name:namesFor(s)[a.attention.at(-1).target],at:a.attention.at(-1).at}:null,
+    encounteredConduct:(s.encounters?.[seat]||[]).filter(e=>e.actor===seat&&e.mode==='direct').map(e=>({text:e.text,source:e.root})).slice(-8),
+    heardClaims:s.discoveries[seat].filter(d=>d.category==='identity_claim').map(d=>({text:d.text,source:namesFor(s)[d.source]||null})),
+    heldPossibility:projection?{target:namesFor(s)[projection.target]||'an encountered configuration',status:projection.status}:null};
+}
diff --git a/lib/case-communication.mjs b/lib/case-communication.mjs
new file mode 100644
index 0000000..f9f8469
--- /dev/null
+++ b/lib/case-communication.mjs
@@ -0,0 +1,38 @@
+import { NAMES, namesFor,HUMAN_IDS,NPC_IDS,person,hears,entry,inhabitantIds,nonPlayerIds } from './case-world.mjs';
+import {canSpeak} from './case-life.mjs';
+export function acquire(s,seat,record,mode,source=null){
+  const key=`${record.root}:${record.version||1}`;
+  const old=s.discoveries[seat].find(d=>d.key===key);
+  if(old){if(mode==='direct'&&old.mode!=='direct'){old.mode='direct';old.source=null;}return false;}
+  s.discoveries[seat].push({...record,key,mode,source,acquiredAt:s.world.elapsedDays});return true;
+}
+export function emit(s,from,to,words,record=null){
+  const producer=person(s,from);if(!canSpeak(producer))return[];
+  const listeners=inhabitantIds(s).filter(id=>id!==from&&hears(s,from,id));
+  const audience=HUMAN_IDS.filter(id=>id===from||listeners.includes(id));
+  const signal={id:`speech:${++s.serial}`,producer:from,to,words,at:s.world.elapsedDays,encounteredBy:listeners,root:record?.root||null};s.signals.push(signal);
+  if(audience.length)entry(s,audience,'speech',words,{speaker:namesFor(s)[from],addressedTo:namesFor(s)[to],signalId:signal.id});
+  for(const id of listeners){
+    if(HUMAN_IDS.includes(id)&&record)acquire(s,id,record,'reported',from);
+    if(record?.category==='incident'){s.encounters||={};s.encounters[id]||=[];if(!s.encounters[id].some(e=>e.root===record.root))s.encounters[id].push({...record,mode:'reported',source:from});}
+    retainWords(s,from,id,words,record,signal.id,'local');
+  }
+  return listeners;
+}
+
+export function retainWords(s,from,to,words,record,signalId,channel='local'){
+  if(!nonPlayerIds(s).includes(to))return;
+  const k=s.npcKnowledge[to];
+  k.memory.push({signal:signalId,from,to,words,root:record?.root||null,at:s.world.elapsedDays,channel});
+  if(record?.category==='identity_claim')(k.identityClaims||=[]).push({from,words,source:record.root,at:s.world.elapsedDays,status:'heard'});
+  if(record&&['access','means','timeline'].includes(record.category)&&!k.seenRoots.includes(record.root))k.seenRoots.push(record.root);
+  for(const subject of NPC_IDS){
+    const named=new RegExp(`\\b${namesFor(s)[subject]}\\b`,'i').test(words);
+    if(named&&/\b(killed|murdered|killer|guilty)\b/i.test(words)&&!/\b(not|never|without evidence|might|maybe|whether|if|ask)\b/i.test(words)){
+      if(k.promises[from]&&!record&&!k.seenRoots.length&&!k.breaches.includes(from)){
+        k.breaches.push(from);
+        for(const c of s.commitments[from]||[])if(c.to===to&&c.status==='heard')c.status='broken';
+      }
+    }
+  }
+}
