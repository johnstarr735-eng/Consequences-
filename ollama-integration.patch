+}
+function tinyTie(w,id,x,y){return (hash01(`${w.seed||0}:${w.clock}:${id}:${x},${y}`)-.5)*1e-7}
+
+function initializeEmbodiedPositions(w){
+  if(w._embodiedGeometryInitialized)return;
